[Unit]
Description=HolaFresca (main working checkout, LAN)
After=network-online.target

[Service]
# Serves the main checkout directly, so whatever is in the working tree — including
# uncommitted work — is what the LAN sees. This replaces holafresca-testing.service
# on :8100; the two cannot run together, since they want the same port.
WorkingDirectory=%h/Documents/Programming/AI/HolaFresca
ExecStart=%h/Documents/Programming/AI/HolaFresca/.venv/bin/python run.py
Environment=HOST=0.0.0.0
Environment=PORT=8100
# Backend edits take effect on save. run.py scopes the watcher to app/ so the
# data directory is not watched.
Environment=UVICORN_RELOAD=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
