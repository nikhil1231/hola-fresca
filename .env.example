# Copy to .env (gitignored) and fill in. Used by the ingredient→product mapping
# proposal pass (app/mapping).
OPENAI_API_KEY=sk-...
# Optional: override the model used for proposals.
# HOLAFRESCA_OPENAI_MODEL=gpt-5.6-luna
# Optional: use a separate model for first-cook recipe graph extraction.
# HOLAFRESCA_COOK_MAP_MODEL=gpt-5.6-luna

# Account identity. Cloudflare Access supplies these values from Google in
# production; localhost and LAN requests bypass Access, so the UI uses this
# presentation-only mock instead. It never chooses a database user or grants
# permissions. If LOCAL_USER_EMAIL is omitted, ACCESS_OWNER_EMAIL is reused.
HOLAFRESCA_LOCAL_USER_NAME=Local User
HOLAFRESCA_LOCAL_USER_EMAIL=local@holafresca.test

# Production Cloudflare Access settings (leave unset for local-only installs).
# HOLAFRESCA_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# HOLAFRESCA_ACCESS_AUD=your-application-audience-tag
# HOLAFRESCA_ACCESS_HOSTNAME=hola.example.com
# HOLAFRESCA_ACCESS_OWNER_EMAIL=you@example.com

# Ocado accounts. The account ids are stable slugs used by the app; labels are
# what the UI shows.
OCADO_ACCOUNTS=main,backup
OCADO_MAIN_LABEL=Main
OCADO_MAIN_EMAIL=you@example.com
OCADO_MAIN_PASSWORD=...
OCADO_BACKUP_LABEL=Backup
OCADO_BACKUP_EMAIL=other@example.com
OCADO_BACKUP_PASSWORD=...
OCADO_LOGIN_HEADLESS=1

# A slow pulse that re-checks each Ocado session, so a dead login is found a day
# before the cutoff rather than at it — and so session lifetime is measured
# continuously instead of only when someone happens to shop. It never escalates
# past the silent refresh, so it can never email anyone a one-time code.
#
# Off unless set, because it talks to Ocado: a dev server should not start
# probing on its own. Turn it on wherever the app actually runs.
HOLAFRESCA_OCADO_HEARTBEAT=1
# Nominal hours between checks per account, jittered by +/-25% and staggered
# across accounts. Daily is plenty: sessions live on the order of days, and the
# traffic shape matters more than the volume.
# HOLAFRESCA_OCADO_HEARTBEAT_HOURS=24
# Waking hours, local time. A session probe at 04:00 has no human explanation.
# HOLAFRESCA_OCADO_HEARTBEAT_WINDOW=09:00-21:00

# Ocado emails a one-time code on every full login. Point this at a *dedicated*
# mailbox that the real Ocado addresses forward their Ocado mail into, and
# re-auth needs nobody at the keyboard. Deliberately not the address registered
# with Ocado: password resets go there, so this mailbox is worth much less if
# its app password leaks. Leave unset to keep typing codes by hand.
#
# Gmail: turn on 2FA, then Google Account -> Security -> App passwords.
OCADO_OTP_IMAP_USER=holafresca-otp@gmail.com
OCADO_OTP_IMAP_PASSWORD=abcd efgh ijkl mnop
# OCADO_OTP_IMAP_HOST=imap.gmail.com
# OCADO_OTP_IMAP_PORT=993
# OCADO_OTP_IMAP_FOLDER=INBOX
# Seconds to wait for the code before falling back to asking for it.
# OCADO_OTP_WAIT_S=120
# OCADO_OTP_POLL_S=4
# Both accounts share one mailbox, so each code has to be tied back to an
# account. Defaults to the account's own email plus the plus-addressed
# destination (holafresca-otp+main@gmail.com); override if forwarding strips both.
# OCADO_MAIN_OTP_MARKERS=you@example.com,holafresca-otp+main@gmail.com
